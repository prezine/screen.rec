# Build-time settings for the desktop app (read by electron-vite and electron-builder).
# Copy to .env, or set them in CI.

# The Toom API (separate repo: toon-api). Development builds default to http://localhost:8787.
TOOM_API_URL=https://api.toom.example
# Public half of the entitlement key pair (npm run keys in toon-api). Lets the app trust
# Pro offline for a few days. Without it, the app trusts the server's last answer for 3 days.
TOOM_ENTITLEMENT_PUBLIC_KEY=
# Where installed apps look for updates: a folder (S3, R2, any static host) holding the
# latest*.yml files and installers from dist/ after `npm run dist:mac` / `dist:win`.
TOOM_UPDATE_URL=https://downloads.toom.example/releases
